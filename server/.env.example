# 서버 (docker compose up -d 로 PostgreSQL·Redis를 먼저 띄운다)
PORT=3000
NODE_ENV=development

# PostgreSQL
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=choseong_battle
PGUSER=postgres
PGPASSWORD=ssafy

# Redis — docker compose up -d 로 띄운다 (루트 docker-compose.yml)
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# CORS 허용 목록 (쉼표 구분)
# 배포 시: https://<appName>.web.tossmini.com,https://<appName>.private-web.tossmini.com
# 5173이 다른 프로젝트에 점유되면 Vite가 5174로 밀린다 — 둘 다 열어 둔다
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
